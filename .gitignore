# This app runs on config/ defaults rather than a .env, but nothing stops someone creating one, and
# an unignored .env is how APP_KEY and database credentials get committed.
.env
.env.*
# Except this one, which is committed and deliberately empty: with APP_ENV=testing Laravel looks for
# `.env.testing` first, and phpdotenv warns on every boot when neither it nor `.env` exists. It holds no
# values — phpunit.xml carries the test environment — so there is nothing here to leak.
!.env.testing

/.phpunit.cache
/bootstrap/ssr
/node_modules
/public/build
/public/fonts-manifest.dev.json
/public/hot
/public/storage
/storage/*.key
/storage/pail
/tmp
/resources/js/actions
/resources/js/routes
/resources/js/wayfinder
/vendor
.DS_Store
.phpactor.json
.phpunit.result.cache
Homestead.json
Homestead.yaml
npm-debug.log
yarn-error.log
/auth.json
/.fleet
/.idea
/.nova
/.playwright
/.playwright-cli
/.zed

frankenphp
frankenphp-worker.php
