{
  // PHP is supplied by mise and runs directly, so the extension should not go looking for Sail, Herd,
  // Valet or a Docker wrapper to proxy commands through — "auto" picking one of those is what breaks IDE
  // discovery. This holds inside a devbox container too, where the editor already runs beside the app.
  "Laravel.phpEnvironment": "local",
  "editor.codeActionsOnSave": {
    "source.fixAll.oxc": "explicit"
  },
  "editor.defaultFormatter": "oxc.oxc-vscode",
  "editor.formatOnSave": true,
  "editor.quickSuggestions": {
    "strings": "on"
  },
  "files.associations": {
    "*.css": "tailwindcss"
  },
  "js/ts.experimental.useTsgo": true,
  "js/ts.format.enabled": false,
  "js/ts.preferences.importModuleSpecifier": "non-relative"
}
