# Deny everything, then allow only what the build reads. New top-level files are excluded by
# default, so a build that suddenly cannot find one needs a `!` line here.
*
!app
!bootstrap
!config
!database
!public
!resources
!routes
!artisan
!composer.json
!composer.lock
!mise.toml
!mise.lock
!package.json
!bun.lock
!tsconfig.json
!vite.config.ts

# Generated inside the image. Copying a host build in would ship stale assets.
bootstrap/cache/*.php
bootstrap/ssr
public/build
public/hot
public/frankenphp-worker.php
public/storage
resources/js/actions
resources/js/routes
resources/js/wayfinder
