<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="DB_CONNECTION" value="pgsql"/>
        <!-- No SSR server runs during tests; without this every Inertia response pays a failed
             connection to the SSR gateway before falling back to client rendering. -->
        <env name="INERTIA_SSR_ENABLED" value="false"/>
        <!-- config/ defaults to the local stack, so without these the suite would mail through mailpit and
             write objects into seaweedfs. -->
        <env name="FILESYSTEM_DISK" value="local"/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <!-- Sends every signal to a no-op exporter so no test opens an OTLP connection to OpenObserve or
             pays an export timeout on shutdown. Deliberately not OTEL_SDK_DISABLED: PHPUnit rewrites a
             value of "true" to "1", which the OTel SDK rejects as an invalid boolean and reads as false,
             and Laravel's env repository is immutable so the package cannot correct it afterwards. -->
        <env name="OTEL_LOGS_EXPORTER" value="null"/>
        <env name="OTEL_METRICS_EXPORTER" value="null"/>
        <env name="OTEL_TRACES_EXPORTER" value="null"/>
    </php>
</phpunit>
